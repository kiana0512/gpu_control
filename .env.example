ENVIRONMENT=production
CONTROL_HOST=192.168.10.10
WORKER_3090_A_HOST=192.168.10.11
WORKER_3090_B_HOST=192.168.10.12

DATABASE_URL=postgresql+asyncpg://gpu_control:CHANGE_ME@postgres:5432/gpu_control
POSTGRES_DB=gpu_control
POSTGRES_USER=gpu_control
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
API_KEY_PEPPER=CHANGE_ME_64_RANDOM_CHARS
NODE_AGENT_HMAC_SECRET=CHANGE_ME_64_RANDOM_CHARS
NODE_AGENT_HMAC_SECRET_WORKER_3090_A=CHANGE_ME_UNIQUE_64_RANDOM_CHARS
NODE_AGENT_HMAC_SECRET_WORKER_3090_B=CHANGE_ME_UNIQUE_64_RANDOM_CHARS
NODE_AGENT_HMAC_SECRET_CONTROL_4090=CHANGE_ME_UNIQUE_64_RANDOM_CHARS
ALERTMANAGER_WEBHOOK_TOKEN=CHANGE_ME_64_RANDOM_CHARS
ASSET_WORKER_HMAC_SECRET=CHANGE_ME_UNIQUE_64_RANDOM_CHARS

API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=https://192.168.10.10
GRAFANA_BASE_URL=https://192.168.10.10/grafana
ALLOWED_CALLBACK_HOSTS=

COMFY_PORT=8188
NODE_AGENT_PORT=9201
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400
JOB_ROOT=/srv/gpu-control/jobs
ASSET_ROOT=/srv/gpu-control/assets
MODEL_ROOT=/opt/imageclip/models
IMAGECLIP_ROOT=/opt/imageclip
MODELVIEW_ROOT=/opt/modelviewcreator

NODE_HEARTBEAT_INTERVAL_SECONDS=5
NODE_HEARTBEAT_TIMEOUT_SECONDS=20
SCHEDULER_FALLBACK_SCAN_MS=500
NODE_MAX_CONCURRENCY=1
DEFAULT_TENANT_MAX_QUEUED=20
DEFAULT_TENANT_MAX_RUNNING=1
SYSTEM_MAX_QUEUED=500
# Test clients stop at 450 queued GPU jobs so production can still enter.
SYSTEM_PRODUCTION_QUEUE_RESERVE=50
PRIORITY_AGING_SECONDS=300

OVERFLOW_QUEUE_THRESHOLD=20
OVERFLOW_WAIT_THRESHOLD_SECONDS=120
OVERFLOW_4090_MAX_GPU_UTIL_PERCENT=20
OVERFLOW_4090_MIN_FREE_VRAM_MB=20000
OVERFLOW_4090_AUTO_ENABLED=false
OVERFLOW_4090_ALLOWED_WINDOWS=
OVERFLOW_4090_SENTINEL=/run/gpu-control/4090.reserved
OVERFLOW_4090_FREE_MODELS_AFTER_IDLE_SECONDS=120

JOB_DEFAULT_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=40000000
BATCH_MAX_FRAMES=5000
BATCH_MAX_ARCHIVE_BYTES=107374182400
BATCH_MAX_UNCOMPRESSED_BYTES=107374182400
BATCH_MAX_FRAME_BYTES=67108864
BATCH_FEED_WINDOW=12
BATCH_MAX_RUNNING_PER_TENANT=3
ASSET_MAX_UPLOAD_BYTES=2147483648
ASSET_WORKER_LEASE_SECONDS=300
ASSET_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
# Codex-dependent jobs fail closed when the most recent healthy exec probe is older than this.
ASSET_CODEX_PROBE_MAX_AGE_SECONDS=3600
ASSET_WORKER_MAX_CONCURRENCY=2
ASSET_WORKER_MAX_CONCURRENCY_CONTROL=2
ASSET_WORKER_MAX_LOAD_PER_CPU=0.85
ASSET_WORKER_MIN_AVAILABLE_MEMORY_MB=8192
ASSET_JOB_MAX_ATTEMPTS=2
SUBSTANCE_PENDING_RESERVATION_SECONDS=60
# strict: QA failure blocks delivery; advisory: deliver with a retained QA warning.
UV_QA_ENFORCEMENT=advisory
RETOPOLOGY_QA_ENFORCEMENT=advisory
# Semantic worker version is separate from the image tag selector so a mutable
# tag can never become OCI release metadata.
ASSET_WORKER_VERSION=1.4.19-retopo-progress-v1
ASSET_WORKER_IMAGE_TAG=1.4.19-retopo-progress-v1
BLENDER_BASE_IMAGE=li3d/blender-runtime:5.1.2
BLENDER_SKILL_VERSION=asset-skills-retopology-v2.3.0
CODEX_SKILL_ROOT=/opt/gpu-control/runtime/asset-skills
CODEX_BINARY_PATH=/opt/gpu-control/runtime/codex/codex
CODEX_BINARY=/usr/local/bin/codex
# Each physical host must authenticate Codex independently. Never copy this file
# into Git or bake it into an image.
CODEX_ASSET_AUTH_PATH=/home/lilithgames/.codex/auth.json
# Writable per-node homes preserve rotated refresh tokens across container replacement.
CODEX_RUNTIME_ROOT=/opt/gpu-control/runtime/codex
RETOPOFLOW_RUNTIME_ROOT=/opt/gpu-control/runtime/retopoflow/RetopoFlow
SUCCESS_INPUT_RETENTION_DAYS=7
SUCCESS_OUTPUT_RETENTION_DAYS=30
FAILED_DIAGNOSTIC_RETENTION_DAYS=30
LOKI_RETENTION_DAYS=30

COMFY_IMAGE=registry.local:5000/gpu-control/comfyui:projects-0.2.3
APP_IMAGE_TAG=1.5.11
# Deployment selectors can carry component-specific hotfix suffixes while the
# immutable application version and OCI labels remain GPU_CONTROL_VERSION.
ASSET_API_IMAGE_TAG=1.6.18-retopo-progress-v1
WEB_IMAGE_TAG=1.5.11-retopo-direct-v2
# Semantic application version is intentionally separate from the mutable
# local/tag selector so a tag such as "candidate" can never become API/Web
# version metadata.
GPU_CONTROL_VERSION=1.5.11
GPU_CONTROL_IMAGE_REGISTRY=
# Release builds must set the exact 40-character GPU Control Git commit so
# every control-plane OCI image carries immutable source provenance.
GPU_CONTROL_REVISION=
VITE_MODELVIEW_PROMPT_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
