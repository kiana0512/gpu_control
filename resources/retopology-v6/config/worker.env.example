# Paths inside the Worker container. Do not put secrets in this file.
BLENDER_EXECUTABLE=/opt/blender/blender
CODEX_BIN=/usr/local/bin/codex
CODEX_HOME=/var/lib/li3d/codex-runtime
RETOPOLOGY_SKILL_ROOT=/opt/li3d/skills/blender-retopology-compare-iterate
RETOPOLOGY_POLICY_PATH=/opt/li3d/config/retopology-policy-v6.json
RETOPOLOGY_PROMPT_PATH=/opt/li3d/prompts/formal-retopology-agent.md
RETOPOLOGY_QA_PROMPT_PATH=/opt/li3d/prompts/automatic-qa-agent.md
JOB_ROOT=/jobs
ARTIFACT_TMP_ROOT=/jobs/.artifact-tmp

# No TARGET_FACES variable exists in V6.
RETOPOLOGY_BUDGET_MODE=automatic
RETOPOLOGY_INTERNAL_CORRECTION_ROUNDS_MAX=2
RETOPOLOGY_RENDER_SIZE=768
RETOPOLOGY_BLENDER_TIMEOUT_SECONDS=5400
RETOPOLOGY_CODEX_TIMEOUT_SECONDS=1800
RETOPOLOGY_JOB_TIMEOUT_SECONDS=7200
RETOPOLOGY_CANCEL_GRACE_SECONDS=20
RETOPOLOGY_MAX_INPUT_BYTES=2147483648
RETOPOLOGY_MAX_EXPANDED_BYTES=4294967296
RETOPOLOGY_MAX_ARCHIVE_FILES=10000
RETOPOLOGY_MAX_REFERENCE_IMAGES=16
RETOPOLOGY_MAX_MESH_OBJECTS=10000
RETOPOLOGY_MAX_INPUT_TRIANGLES=100000000
RETOPOLOGY_MAX_TEXTURE_PIXELS=1073741824

# Internal CA. Never disable TLS verification.
SSL_CERT_FILE=/etc/li3d/certs/GPU_CONTROL_LAN_CA.crt
REQUESTS_CA_BUNDLE=/etc/li3d/certs/GPU_CONTROL_LAN_CA.crt
NODE_EXTRA_CA_CERTS=/etc/li3d/certs/GPU_CONTROL_LAN_CA.crt

# Inject actual service endpoints and credentials through the deployment secret system.
CONTROL_PLANE_BASE_URL=https://10.3.34.11
OBJECT_STORAGE_ENDPOINT=__INJECT_AT_DEPLOYMENT__
DATABASE_URL=__INJECT_AS_SECRET__
REDIS_URL=__INJECT_AS_SECRET__
CODEX_API_KEY=__INJECT_AS_SECRET__
