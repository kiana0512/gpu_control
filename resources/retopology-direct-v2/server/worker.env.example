# Required runtime paths
BLENDER_EXECUTABLE=/opt/blender/blender
CODEX_BIN=/usr/local/bin/codex

# Codex CLI arguments. The final '-' reads the rendered skill prompt from stdin.
CODEX_EXEC_ARGS_JSON='["exec","--full-auto","--json","-C","{job_dir}","-"]'

# One job is allowed to run for at most two hours. A generated-but-unexecuted
# Blender build and coordinate finalization each have a separate bounded limit.
RETOPOLOGY_FBX_IMPORT_TIMEOUT_SECONDS=600
RETOPOLOGY_TIMEOUT_SECONDS=7200
RETOPOLOGY_GENERATED_BUILD_TIMEOUT_SECONDS=1800
RETOPOLOGY_FINALIZE_TIMEOUT_SECONDS=1800
