# Required runtime paths
BLENDER_EXECUTABLE=/opt/blender/blender
CODEX_BIN=/usr/local/bin/codex

# Codex CLI arguments. The final '-' reads the rendered skill prompt from stdin.
CODEX_EXEC_ARGS_JSON=["exec","--full-auto","--json","-C","{job_dir}","-"]

# One job is allowed to run for at most two hours. The wrapper never retries modeling.
RETOPOLOGY_TIMEOUT_SECONDS=7200
