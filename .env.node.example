ENVIRONMENT=production
GPU_CONTROL_ROLE=node
CONTROL_HOST=192.168.10.10
NODE_ID=worker-3090-a
NODE_BIND_IP=0.0.0.0
NODE_ADVERTISE_IP=192.168.10.11
NODE_MAC_ADDRESS=

COMFY_IMAGE=registry.local:5000/gpu-control/comfyui:projects-0.2.3
MODEL_ROOT=/opt/imageclip/models
IMAGECLIP_ROOT=/opt/imageclip
MODELVIEW_ROOT=/opt/modelviewcreator
NODE_AGENT_PORT=9201
NODE_HEARTBEAT_INTERVAL_SECONDS=10
NODE_CONTROL_CA_CERT=/etc/gpu-control/lan-ca.crt
NODE_EXPORTER_PORT=9100
DCGM_EXPORTER_PORT=9400
NODE_AGENT_HMAC_SECRET=CHANGE_ME_UNIQUE_SECRET_FOR_THIS_NODE
ASSET_WORKER_HMAC_SECRET=CHANGE_ME_UNIQUE_64_RANDOM_CHARS
ASSET_WORKER_MAX_CONCURRENCY=2
# Semantic worker version and tag must be bumped together for an immutable
# release. GPU_CONTROL_REVISION must be the same pushed 40-character commit
# used by the control-plane images; never ship a Worker labelled "unknown".
ASSET_WORKER_VERSION=1.4.35-retopo-fast-delivery-v1
ASSET_WORKER_IMAGE_TAG=1.4.35-retopo-fast-delivery-v1
GPU_CONTROL_REVISION=
BLENDER_BASE_IMAGE=li3d/blender-runtime:5.1.2
BLENDER_SKILL_VERSION=asset-skills-auto-retopo-align-v3.0.13
LAN_CA_PATH=/opt/gpu-control/deploy/control-plane/nginx/certs/lan-ca.crt
