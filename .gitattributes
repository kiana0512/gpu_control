# Approved upstream retopology releases are checksum-verified byte-for-byte.
# Do not normalize their original line endings when storing or checking out.
resources/retopology-direct-v2/** -text !eol
# Runtime-approved Skills are also SHA-256 pinned byte-for-byte. Preserve the
# reviewed bytes (including upstream line endings) on every checkout.
runtime/asset-skills/** -text !eol
