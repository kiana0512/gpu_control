[Unit]
Description=GPU Control MinistryOfFlat Windows UV Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/gpu-control
ExecStart=/usr/bin/python3 /opt/gpu-control/apps/mof_worker/mof_worker.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
