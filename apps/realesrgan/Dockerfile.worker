ARG PYTORCH_IMAGE=pytorch/pytorch@sha256:c16f4c749e2d9e96878875cdf6cc45cddda1d1a36fddd371dd6f2360f1b6e2a2
FROM ${PYTORCH_IMAGE}
ARG GPU_CONTROL_VERSION=1.0.0
ARG GPU_CONTROL_REVISION=unknown
ARG MODEL_URL=https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth
ARG MODEL_SHA256=f872d837d3c90ed2e05227bed711af5671a6fd1c9f7d7e91c911a61f155e99da
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/realesrgan/src \
    GPU_CONTROL_BUILD_VERSION=${GPU_CONTROL_VERSION} GPU_CONTROL_BUILD_REVISION=${GPU_CONTROL_REVISION} \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility
LABEL org.opencontainers.image.title="GPU Control Real-ESRGAN CUDA Worker" \
      org.opencontainers.image.version="${GPU_CONTROL_VERSION}" \
      org.opencontainers.image.revision="${GPU_CONTROL_REVISION}" \
      io.gpu-control.model="RealESRGAN_x4plus_anime_6B" \
      io.gpu-control.model.sha256="${MODEL_SHA256}" \
      io.gpu-control.pytorch="2.7.1" io.gpu-control.cuda="12.8"
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python -m pip install --no-cache-dir \
       fastapi==0.141.1 numpy==2.2.6 opencv-python-headless==4.12.0.88 Pillow==11.3.0 uvicorn==0.35.0 \
    && groupadd --gid 10001 realesrgan \
    && useradd --uid 10001 --gid realesrgan --create-home realesrgan \
    && install -d -o realesrgan -g realesrgan /opt/realesrgan/models
RUN curl --fail --show-error --location --retry 3 "${MODEL_URL}" \
      -o /opt/realesrgan/models/RealESRGAN_x4plus_anime_6B.pth \
    && echo "${MODEL_SHA256}  /opt/realesrgan/models/RealESRGAN_x4plus_anime_6B.pth" | sha256sum --check \
    && chown realesrgan:realesrgan /opt/realesrgan/models/RealESRGAN_x4plus_anime_6B.pth
WORKDIR /opt/realesrgan
COPY apps/realesrgan/src ./src
USER realesrgan
EXPOSE 9301
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9301/health/live',timeout=2)"
CMD ["uvicorn", "gpu_control_realesrgan.worker:app", "--host", "0.0.0.0", "--port", "9301", "--workers", "1"]
